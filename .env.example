PORT=3000
THROTTLE_MS=600
CONCURRENCY=2
SCRAPE_INTERVAL_MIN=0

# Base URL for links in notification emails (dashboard + unsubscribe).
PUBLIC_BASE_URL=http://localhost:3000

# SMTP for email notifications. When SMTP_HOST is unset, emails are logged to
# stdout instead of being sent (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=festzelt@lehel.xyz